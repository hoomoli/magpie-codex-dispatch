{
  "name": "magpie-codex-dispatch",
  "version": "0.0.9",
  "magpie": {
    "name": "magpie-codex-dispatch"
  },
  "description": "通过 Magpie 在 Codex 桌面新建和派发任务，支持项目选择与安全会话交接。 Create and dispatch Codex desktop tasks through Magpie, with project selection and safe session handoff.",
  "type": "module",
  "main": "src/index.js",
  "exports": "./src/index.js",
  "files": [
    "src",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node scripts/check.mjs",
    "probe": "node scripts/probe.mjs",
    "acceptance:connect": "node scripts/acceptance.mjs --profile connect",
    "acceptance:release": "node scripts/acceptance.mjs --profile release",
    "acceptance:check": "node scripts/acceptance-gate.mjs",
    "acceptance:release:check": "node scripts/acceptance-gate.mjs --require-profile release"
  },
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin"
  ],
  "license": "MIT",
  "author": "hoomoli <hoomoli@outlook.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoomoli/magpie-codex-dispatch.git"
  },
  "keywords": [
    "magpie",
    "codex",
    "mcp",
    "desktop",
    "claude"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "immer": "10.1.1"
  },
  "bin": {
    "claude-codex": "./src/claude-channel.js",
    "codex-completion-channel": "./src/channel.js",
    "codex-install-desktop": "./src/install-desktop.js",
    "codex-notifications": "./src/notifications.js"
  }
}
